# Copy this file to .env.local for development or configure these values in deployment secrets.
# Do not commit real passwords, tokens, API keys, or service-role credentials here.

# Next.js application
APP_NAME=RBCA
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

# Supabase: required by survey submissions and the admin dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard
SURVEY_ADMIN_PASSWORD=your-admin-password

# Genesys PGR embedded germplasm request workflow
# These GENESYS_* names are the canonical application configuration.
GENESYS_ENABLED=true
GENESYS_API_URL=https://api.genesys-pgr.org
GENESYS_API_TOKEN=your-genesys-api-token
GENESYS_CLIENT_ID=your-genesys-client-id
GENESYS_CLIENT_KEY=your-genesys-client-key
GENESYS_CAPTCHA_SITE_KEY=your-genesys-captcha-site-key
GENESYS_INSTITUTE_CODE=CIV033
GENESYS_ASSETS_URL=https://cdn.jsdelivr.net/npm/@genesys-pgr/ui-embedded@1.6.0/dist
GENESYS_SHOPPING_CART_ENABLED=true

# Optional browser-prefixed aliases for deployments that require them.
NEXT_PUBLIC_GENESYS_API_URL=https://api.genesys-pgr.org
NEXT_PUBLIC_GENESYS_CLIENT_ID=your-genesys-client-id
NEXT_PUBLIC_GENESYS_CLIENT_KEY=your-genesys-client-key
NEXT_PUBLIC_GENESYS_CAPTCHA_SITE_KEY=your-genesys-captcha-site-key
NEXT_PUBLIC_GENESYS_INSTITUTE_CODE=CIV033
NEXT_PUBLIC_GENESYS_API_TOKEN=your-genesys-api-token
NEXT_PUBLIC_GENESYS_ASSETS_URL=https://cdn.jsdelivr.net/npm/@genesys-pgr/ui-embedded@1.7.6/dist
NEXT_PUBLIC_GENESYS_SHOPPING_CART_ENABLED=true

# Existing Laravel-compatible settings retained for migration compatibility
APP_KEY=base64:replace-with-generated-key
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ar_feedback
DB_USERNAME=your-database-user
DB_PASSWORD=your-database-password
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=RBCA
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
VITE_APP_NAME=RBCA

# Legacy source names from the old integration.
# The active Next.js app uses the NEXT_PUBLIC_GENESYS_* names above.
API_GEN_URL=https://api.genesys-pgr.org
API_GEN_CLIENTID=your-genesys-client-id
API_GEN_CLIENTKEY=your-genesys-client-key
API_GEN_TOKEN=your-genesys-token
API_GEN_CAPTCHA=your-genesys-captcha-site-key
API_GEN_SHOP=true
API_GEN_INSCODE=CIV033
